From 9f61119848eaa963032da0fe9765a150f13997d4 Mon Sep 17 00:00:00 2001
From: Reyka Matthies <openglfreak@googlemail.com>
Date: Fri, 27 Mar 2026 20:15:39 +0100
Subject: [PATCH 59/60] winevulkan: Mark more functions as perf-critical.

---
 dlls/winevulkan/make_vulkan |   9 +++-
 dlls/winevulkan/vulkan.c    | 103 ++++++++++++++++++++++--------------
 2 files changed, 69 insertions(+), 43 deletions(-)

diff --git a/dlls/winevulkan/make_vulkan b/dlls/winevulkan/make_vulkan
index 43fff124766..923a87474a1 100755
--- a/dlls/winevulkan/make_vulkan
+++ b/dlls/winevulkan/make_vulkan
@@ -828,7 +828,9 @@ class VkFunction(object):
         # vkCmd* functions are frequently called, do not trace for performance
         if self.name.startswith("vkCmd") and self.type == "void":
             return True
-        return self.name in PERF_CRITICAL_FUNCTIONS
+        if self.name == "vkDestroyInstance" or self.name == "vkDestroyDevice":
+            return False
+        return self.type == "void" or self.name in PERF_CRITICAL_FUNCTIONS
 
     def pfn(self, prefix="p", call_conv=None):
         """ Create function pointer. """
@@ -863,7 +865,10 @@ class VkFunction(object):
             prefix (str, optional): prefix to append prior to function name e.g. vkFoo -> wine_vkFoo
         """
 
-        proto = "{0}".format(self.type)
+        if self.type == "void" and is_thunk:
+            proto = "NTSTATUS"
+        else:
+            proto = "{0}".format(self.type)
 
         if call_conv is not None:
             proto += " {0}".format(call_conv)
