+/* Zero-copy IMFMediaBuffer wrapping a GStreamer buffer.
+ * Lock() returns a direct pointer to the gst_buffer_map'd data.
+ * Release() calls wg_parser_stream_release_buffer() to free the
+ * GStreamer buffer when the last COM reference is dropped. */
+
+struct wg_media_buffer
+{
+    IMFMediaBuffer IMFMediaBuffer_iface;
+    LONG ref;
+    wg_parser_stream_t wg_stream;
+    BYTE *data;
+    DWORD size;
+    DWORD current_length;
+    BOOL locked;
+    BOOL released;
+};
+
+static struct wg_media_buffer *impl_from_IMFMediaBuffer(IMFMediaBuffer *iface)
+{
+    return CONTAINING_RECORD(iface, struct wg_media_buffer, IMFMediaBuffer_iface);
+}
+
+static HRESULT WINAPI wg_media_buffer_QueryInterface(IMFMediaBuffer *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IMFMediaBuffer))
+    {
+        *obj = iface;
+        IMFMediaBuffer_AddRef(iface);
+        return S_OK;
+    }
+
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI wg_media_buffer_AddRef(IMFMediaBuffer *iface)
+{
+    struct wg_media_buffer *buf = impl_from_IMFMediaBuffer(iface);
+    return InterlockedIncrement(&buf->ref);
+}
+
+static ULONG WINAPI wg_media_buffer_Release(IMFMediaBuffer *iface)
+{
+    struct wg_media_buffer *buf = impl_from_IMFMediaBuffer(iface);
+    ULONG ref = InterlockedDecrement(&buf->ref);
+
+    if (!ref)
+    {
+        if (!buf->released)
+        {
+            wg_parser_stream_release_buffer(buf->wg_stream);
+            buf->released = TRUE;
+        }
+        free(buf);
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI wg_media_buffer_Lock(IMFMediaBuffer *iface, BYTE **out_data, DWORD *max_length, DWORD *current_length)
+{
+    struct wg_media_buffer *buf = impl_from_IMFMediaBuffer(iface);
+
+    buf->locked = TRUE;
+    *out_data = buf->data;
+    if (max_length) *max_length = buf->size;
+    if (current_length) *current_length = buf->current_length;
+    return S_OK;
+}
+
+static HRESULT WINAPI wg_media_buffer_Unlock(IMFMediaBuffer *iface)
+{
+    struct wg_media_buffer *buf = impl_from_IMFMediaBuffer(iface);
+    buf->locked = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI wg_media_buffer_GetCurrentLength(IMFMediaBuffer *iface, DWORD *length)
+{
+    struct wg_media_buffer *buf = impl_from_IMFMediaBuffer(iface);
+    *length = buf->current_length;
+    return S_OK;
+}
+
+static HRESULT WINAPI wg_media_buffer_SetCurrentLength(IMFMediaBuffer *iface, DWORD length)
+{
+    struct wg_media_buffer *buf = impl_from_IMFMediaBuffer(iface);
+
+    if (length > buf->size)
+        return E_INVALIDARG;
+
+    buf->current_length = length;
+    return S_OK;
+}
+
+static HRESULT WINAPI wg_media_buffer_GetMaxLength(IMFMediaBuffer *iface, DWORD *length)
+{
+    struct wg_media_buffer *buf = impl_from_IMFMediaBuffer(iface);
+    *length = buf->size;
+    return S_OK;
+}
+
+static const IMFMediaBufferVtbl wg_media_buffer_vtbl =
+{
+    wg_media_buffer_QueryInterface,
+    wg_media_buffer_AddRef,
+    wg_media_buffer_Release,
+    wg_media_buffer_Lock,
+    wg_media_buffer_Unlock,
+    wg_media_buffer_GetCurrentLength,
+    wg_media_buffer_SetCurrentLength,
+    wg_media_buffer_GetMaxLength,
+};
+
+static HRESULT wg_media_buffer_create(wg_parser_stream_t wg_stream, DWORD size, IMFMediaBuffer **out)
+{
+    struct wg_media_buffer *buf;
+    void *data;
+    uint32_t data_size;
+
+    if (!wg_parser_stream_get_buffer_ptr(wg_stream, &data, &data_size))
+    {
+        WARN("Failed to get buffer pointer from stream.\n");
+        return E_FAIL;
+    }
+
+    if (!(buf = calloc(1, sizeof(*buf))))
+        return E_OUTOFMEMORY;
+
+    buf->IMFMediaBuffer_iface.lpVtbl = &wg_media_buffer_vtbl;
+    buf->ref = 1;
+    buf->wg_stream = wg_stream;
+    buf->data = data;
+    buf->size = data_size;
+    buf->current_length = size;
+    buf->locked = FALSE;
+    buf->released = FALSE;
+
+    *out = &buf->IMFMediaBuffer_iface;
+    return S_OK;
+}
