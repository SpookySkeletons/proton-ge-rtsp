+static NTSTATUS wg_parser_stream_get_buffer_ptr(void *args)
+{
+    struct wg_parser_stream_get_buffer_ptr_params *params = args;
+    struct wg_parser_stream *stream = get_stream(params->stream);
+    struct wg_parser *parser = stream->parser;
+
+    pthread_mutex_lock(&parser->mutex);
+
+    if (!stream->buffer_queue[stream->buf_read_idx])
+    {
+        pthread_mutex_unlock(&parser->mutex);
+        params->data = NULL;
+        params->size = 0;
+        return VFW_E_WRONG_STATE;
+    }
+
+    params->data = stream->map_info_queue[stream->buf_read_idx].data;
+    params->size = stream->map_info_queue[stream->buf_read_idx].size;
+
+    pthread_mutex_unlock(&parser->mutex);
+    return S_OK;
+}
