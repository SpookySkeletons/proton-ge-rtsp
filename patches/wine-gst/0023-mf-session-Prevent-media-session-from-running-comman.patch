                     if (session_is_output_nodes_state(session, OBJ_STATE_STARTED))
                         session_set_started(session);
                     else
-                        session->state = SESSION_STATE_STARTING_SINKS;
+                        session_set_state(session, SESSION_STATE_STARTING_SINKS);
