From e4aa9de0ff841d2e5c61afefde4fd5250277327e Mon Sep 17 00:00:00 2001
From: Torge Matthies <openglfreak@googlemail.com>
Date: Thu, 12 Mar 2026 14:58:13 +0100
Subject: [PATCH 60/60] treewide: Fix some variable errors with -Werror

---
 dlls/d3dx9_36/d3dx_helpers.c | 1 +
 dlls/glu32/sweep.c           | 2 ++
 dlls/ntdll/unix/env.c        | 1 +
 dlls/ntdll/unix/server.c     | 1 +
 dlls/win32u/gdiobj.c         | 1 +
 dlls/winevulkan/make_vulkan  | 1 +
 include/msvcrt/assert.h      | 2 +-
 tools/winebuild/spec32.c     | 2 +-
 tools/winedump/tlb.c         | 4 ++++
 9 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/dlls/d3dx9_36/d3dx_helpers.c b/dlls/d3dx9_36/d3dx_helpers.c
index 8db599541a2..0de96836f24 100644
--- a/dlls/d3dx9_36/d3dx_helpers.c
+++ b/dlls/d3dx9_36/d3dx_helpers.c
@@ -2479,6 +2479,7 @@ void format_from_d3dx_color(const struct pixel_format_desc *format, const struct
 
         /* We shouldn't be trying to output to CTYPE_INDEX. */
         case CTYPE_INDEX:
+            v = 0;
             assert(0);
             break;
 
diff --git a/dlls/glu32/sweep.c b/dlls/glu32/sweep.c
index 0bfc9335cb5..7b56c60220d 100644
--- a/dlls/glu32/sweep.c
+++ b/dlls/glu32/sweep.c
@@ -1287,7 +1287,9 @@ static void DoneEdgeDict( GLUtesselator *tess )
      */
     if( ! reg->sentinel ) {
       assert( reg->fixUpperEdge );
+#ifndef NDEBUG
       assert( ++fixedEdges == 1 );
+#endif
     }
     assert( reg->windingNumber == 0 );
     DeleteRegion( tess, reg );
diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index be114894d9f..92f300402ce 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1870,6 +1870,7 @@ static void *build_wow64_parameters( const RTL_USER_PROCESS_PARAMETERS *params )
 
     status = NtAllocateVirtualMemory( NtCurrentProcess(), (void **)&wow64_params, limit_2g - 1, &size,
                                       MEM_COMMIT, PAGE_READWRITE );
+    (void)status;
     assert( !status );
 
     wow64_params->AllocationSize  = size;
diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index cf33cb7a06e..ae977c08f39 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -1819,6 +1819,7 @@ void server_init_process_done(void)
     }
     SERVER_END_REQ;
 
+    (void)status;
     assert( !status );
     signal_start_thread( main_image_info.TransferAddress, peb, suspend, NtCurrentTeb() );
 }
diff --git a/dlls/win32u/gdiobj.c b/dlls/win32u/gdiobj.c
index fec99243aa2..25731f5c0e8 100644
--- a/dlls/win32u/gdiobj.c
+++ b/dlls/win32u/gdiobj.c
@@ -653,6 +653,7 @@ static void init_stock_objects( unsigned int dpi )
 
     obj = NtGdiCreateBitmap( 1, 1, 1, 1, NULL );
 
+    (void)obj;
     assert( (HandleToULong( obj ) & 0xffff) == FIRST_GDI_HANDLE + DEFAULT_BITMAP );
 
     create_scaled_font( &deffonts->SystemFont, dpi );
diff --git a/dlls/winevulkan/make_vulkan b/dlls/winevulkan/make_vulkan
index 923a87474a1..0d55a4534f3 100755
--- a/dlls/winevulkan/make_vulkan
+++ b/dlls/winevulkan/make_vulkan
@@ -906,6 +906,7 @@ class VkFunction(object):
             body += "    UNIX_CALL({0}, &params);\n".format(self.name)
         else:
             body += "    status = UNIX_CALL({0}, &params);\n".format(self.name)
+            body += "    (void)status;\n".format(self.name)
             body += "    assert(!status && \"{0}\");\n".format(self.name)
 
         if self.type != "void":
diff --git a/include/msvcrt/assert.h b/include/msvcrt/assert.h
index 26a9c0a7a5f..01ac9e78d2f 100644
--- a/include/msvcrt/assert.h
+++ b/include/msvcrt/assert.h
@@ -26,7 +26,7 @@ extern "C" {
 
 #undef assert
 #ifdef NDEBUG
-#define assert(_expr) ((void)0)
+#define assert(_expr) ((void)sizeof(!!(_expr)))
 #else
 _ACRTIMP DECLSPEC_NORETURN void __cdecl _assert(const char *, const char *, unsigned int);
 #define assert(_expr) (void)((!!(_expr)) || (_assert(#_expr, __FILE__, __LINE__), 0))
diff --git a/tools/winebuild/spec32.c b/tools/winebuild/spec32.c
index 7c558fe532b..27f67e157da 100644
--- a/tools/winebuild/spec32.c
+++ b/tools/winebuild/spec32.c
@@ -420,7 +420,7 @@ void output_exports( DLLSPEC *spec )
         for (i = exports->base; i <= exports->limit; i++)
         {
             ORDDEF *odp = exports->ordinals[i];
-            const char *symbol;
+            const char *symbol = NULL;
 
             if (!odp) continue;
 
diff --git a/tools/winedump/tlb.c b/tools/winedump/tlb.c
index 3c795162f0e..f17e9bca6d3 100644
--- a/tools/winedump/tlb.c
+++ b/tools/winedump/tlb.c
@@ -1955,15 +1955,19 @@ static void sltg_dump(void)
 
     for (i = n_first_blk - 1; entry[i].next != 0; i = entry[i].next - 1)
     {
+#ifndef NDEBUG
         short magic;
+#endif
         char name[32];
 
         saved_offset = offset;
 
         sprintf(name, "Block %d", i);
         print_begin_block(name);
+#ifndef NDEBUG
         magic = tlb_read_short();
         assert(magic == 0x0501);
+#endif
         offset -= 2;
         dump_binary(entry[i].len);
         print_end_block();
-- 
2.53.0

