From de2eba12ffa6de08e611118be81de5a19aefd178 Mon Sep 17 00:00:00 2001
From: Torge Matthies <openglfreak@googlemail.com>
Date: Sat, 4 Oct 2025 20:59:37 +0200
Subject: [PATCH 48/48] ntdll/unix: Reset MXCSR to the default value on exit
 from __wine_unix_call_dispatcher.

---
 dlls/ntdll/unix/signal_x86_64.c | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/dlls/ntdll/unix/signal_x86_64.c b/dlls/ntdll/unix/signal_x86_64.c
index abb98f73ee0..c53c3c42d57 100644
--- a/dlls/ntdll/unix/signal_x86_64.c
+++ b/dlls/ntdll/unix/signal_x86_64.c
@@ -3486,6 +3486,7 @@ __ASM_GLOBAL_FUNC( __wine_unix_call_dispatcher,
 #endif
                    "movq %r8,%rdi\n\t"             /* args */
                    "callq *(%r10,%rdx,8)\n\t"
+                   "ldmxcsr " __ASM_NAME("__wine_default_mxcsr") "(%rip)\n\t"
                    "movq %rsp,%rcx\n\t"
                    "movdqa 0x1c0(%rcx),%xmm6\n\t"
                    "movdqa 0x1d0(%rcx),%xmm7\n\t"
@@ -3523,4 +3524,10 @@ asm( ".data\n\t"
      ".quad " __ASM_LOCAL_LABEL("__wine_unix_call_dispatcher_prolog_end") "\n\t"
      ".text\n\t" );
 
+asm( ".section .rodata\n\t"
+     ".globl " __ASM_NAME("__wine_default_mxcsr") "\n"
+     __ASM_NAME("__wine_default_mxcsr") ":\n\t"
+     ".quad 0x1f80\n\t"
+     ".text\n\t" );
+
 #endif  /* __x86_64__ */
-- 
2.51.0

