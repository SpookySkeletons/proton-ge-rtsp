+    TRACE("%p, %u\n", sink, queue->used);
     if (queue->used)
     {
         *sample = queue->samples[queue->front];
+        TRACE("%p\n", *sample);
         queue->front = (queue->front + 1) % ARRAY_SIZE(queue->samples);
         queue->used--;
     }
     else
         *sample = NULL;
 
+    TRACE("%p, %u, %p\n", sink, queue->used, *sample);
