     HRESULT hr = S_FALSE;
     LONGLONG sample_pts;
 
+    TRACE("%p %I64u\n", sample, clocktime);
+
     if (sample)
     {
         if (SUCCEEDED(hr = IMFSample_GetSampleTime(sample, &sample_pts)))
         {
+            TRACE("%I64u %I64d\n", clocktime, sample_pts);
             hr = (clocktime >= sample_pts) ? S_OK : S_FALSE;
             if (hr == S_OK)
                 *pts = sample_pts;
@@ -1255,6 +1269,7 @@ static HRESULT sample_get_pts(IMFSample *sample, MFTIME clocktime, LONGLONG *pts
         else
             WARN("Failed to get sample time, hr %#lx.\n", hr);
     }
+    TRACE("hr %#lx\n", hr);
     return hr;
 }
 
@@ -1275,21 +1290,26 @@ HRESULT video_frame_sink_get_pts(struct video_frame_sink *sink, MFTIME clocktime
         IMFSample *sample;
         bool transfer_sample = FALSE;
         EnterCriticalSection(&sink->cs);
+        TRACE("1\n");
         while (video_frame_sink_sample_queue_pop(sink, &sample))
         {
+            TRACE("2\n");
             if (sample_get_pts(sample, clocktime, pts) == S_OK)
             {
+                TRACE("3\n");
                 video_frame_sink_sample_queue_set_presentation(sink, sample);
                 transfer_sample = TRUE;
                 hr = S_OK;
             }
             else
             {
+                TRACE("4\n");
                 video_frame_sink_sample_queue_push(sink, sample, TRUE);
                 break;
             }
         }
 
+        TRACE("5 %d %d\n", transfer_sample, !sink->queue.sample_presented);
         if (transfer_sample)
             video_frame_sink_stream_request_sample(sink);
         else if (!sink->queue.sample_presented)
