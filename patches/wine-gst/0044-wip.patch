     {
         video_frame_sink_sample_queue_pop(sink, &old_sample);
@@ -152,6 +156,7 @@ static void video_frame_sink_sample_queue_push(struct video_frame_sink *sink, IM
         idx = queue->back = (queue->back + 1) % ARRAY_SIZE(queue->samples);
     queue->samples[idx] = sample;
     queue->used++;
+    TRACE("ret %p, %u, %p\n", sink, queue->used, sample);
 }
 
