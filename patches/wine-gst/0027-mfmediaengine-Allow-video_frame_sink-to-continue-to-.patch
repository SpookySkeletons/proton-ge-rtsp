From bb43c347c3aabebf992a88dee9bb2259d9158891 Mon Sep 17 00:00:00 2001
From: Torge Matthies <openglfreak@googlemail.com>
Date: Mon, 2 Sep 2024 09:06:24 +0200
Subject: [PATCH 27/60] mfmediaengine: Allow video_frame_sink to continue to
 work after receiving end-of-stream.

CW-Bug-Id: #21644
---
 dlls/mfmediaengine/main.c             | 2 ++
 dlls/mfmediaengine/video_frame_sink.c | 3 +++
 2 files changed, 5 insertions(+)

diff --git a/dlls/mfmediaengine/main.c b/dlls/mfmediaengine/main.c
index f2875ba17b4..a1de7a729da 100644
--- a/dlls/mfmediaengine/main.c
+++ b/dlls/mfmediaengine/main.c
@@ -997,7 +997,9 @@ static HRESULT WINAPI media_engine_session_events_Invoke(IMFAsyncCallback *iface
             break;
 
         case MEEndOfPresentationSegment:
+            EnterCriticalSection(&engine->cs);
             video_frame_sink_notify_end_of_presentation_segment(engine->presentation.frame_sink);
+            LeaveCriticalSection(&engine->cs);
             break;
     }
 
diff --git a/dlls/mfmediaengine/video_frame_sink.c b/dlls/mfmediaengine/video_frame_sink.c
index 383198b753e..8644b9ffd00 100644
--- a/dlls/mfmediaengine/video_frame_sink.c
+++ b/dlls/mfmediaengine/video_frame_sink.c
@@ -1298,6 +1298,9 @@ HRESULT video_frame_sink_get_pts(struct video_frame_sink *sink, MFTIME clocktime
 void video_frame_sink_notify_end_of_presentation_segment(struct video_frame_sink *sink)
 {
     sink->eos = TRUE;
+    /* At the end of presentation, the media source sends MEEndOfPresentation _instead of_
+       MEMediaSample, so reset sample_request_pending here. */
+    sink->sample_request_pending = FALSE;
 }
 
 ULONG video_frame_sink_release(struct video_frame_sink *sink)
-- 
